# Vendored files stay byte for byte as published, so their recorded checksums hold on every checkout (#46).
ribcage/static/vendor/** -text

# Bash reads a CRLF script as commands ending in a carriage return, so scripts keep LF on every checkout (#59).
*.sh text eol=lf

# The vendoring record is our own text, not a published file, so it keeps LF (#73).
ribcage/static/vendor/vendored.toml text eol=lf

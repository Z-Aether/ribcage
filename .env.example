# Every variable the app and its compose stack read. Copy to .env for local runs; on the host they are set in the stack's environment (#18).
# Placeholders only: real values never go in the repo (#45).
# Values are unquoted, with no inline comments: Compose strips those and docker run --env-file keeps them.

SECRET_KEY=local-development-only-not-a-secret
# true or false; off when unset.
DEBUG=true
# Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, each with its scheme.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Relative to the repo root, or absolute.
DATABASE_PATH=db.sqlite3
# An IANA zone name, such as Europe/London.
TIME_ZONE=UTC
JOIN_CODE=local-join-code
ADMIN_PASSWORD=local-admin-password
TMDB_API_KEY=your-tmdb-api-key
DTDD_API_KEY=your-dtdd-api-key
# The proxy's Docker network, which the stack joins; locally compose.local.yaml creates it (#43, #52).
PROXY_NETWORK=ribcage-proxy

# Judgement constants, each with its default; uncomment to tune without a rebuild (#25).
# DIVERSITY_CUT=4
# FLOOR_WEIGHT_MULTIPLIER=1
# BATCH_SIZE=5
# POLL_INTERVAL_SECONDS=30
# TRIGGER_ICON_THRESHOLD=5
# LOGIN_BACKOFF_FAILURES=5
# LOGIN_BACKOFF_WINDOW_MINUTES=15
# LOGIN_BACKOFF_WAIT_MINUTES=1
